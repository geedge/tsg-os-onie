pf_setup_mcn0()
{
    local eth=$1
    cmd_run ifconfig ${eth} up
    cmd_run ip link add link ${eth} name ${eth}.100 type vlan id 100
    cmd_run ifconfig ${eth}.100 192.168.100.1 netmask 255.255.255.0 up
    cmd_run sleep 1
    log_console_msg "MCN0 : Using static IP config: ${eth}.100 192.168.100.1"
}

