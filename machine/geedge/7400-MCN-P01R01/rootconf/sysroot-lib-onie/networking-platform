config_chassis_mgmt()
{
    local chassis_mgmt_id=$(ipmitool raw 0x2e 0x32 0x13 0x5f 0x00 | awk '{print $NF}')
    case ${chassis_mgmt_id} in
    90)
        pf_setup_mcn0
        ;;
    80)
        pf_setup_mcn1
        ;;
    98)
        pf_setup_mcn2
        ;;
    88)
        pf_setup_mcn3
        ;;
    *)
        log_console_msg "MCNX: Using ipmitool get unknown mcn id"
        ;;
    esac
}

config_ethmgmt_static() {
    local intf=$1
    shift
    
    case $intf in
    ens1)
        config_chassis_mgmt
        ;;
    ens8)
        config_chassis_mgmt
        ;;
    *)
        return 0
        ;;
    esac

    # other interface, do nothing and disable DHCPv4
    return 0
}