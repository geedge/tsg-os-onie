config_chassis_mgmt()
{
    local eth=$1
    local chassis_mgmt_id=$(ipmitool raw 0x2e 0x32 0x13 0x5f 0x00 | awk '{print $NF}')
    case ${chassis_mgmt_id} in
    90)
        pf_setup_mcn0 ${eth}
        ;;
    80)
        pf_setup_mcn1 ${eth}
        ;;
    98)
        pf_setup_mcn2 ${eth}
        ;;
    88)
        pf_setup_mcn3 ${eth}
        ;;
    *)
        ;;
    esac
}

config_ethmgmt_static() {
    local intf=$1
    shift

    local status=$(ethtool -i ${intf} | grep fm10k | wc -l)
    if [ ${status} -eq 1 ];then
		config_chassis_mgmt ${intf}
    fi

    return 0
}