pf_setup_mcn0()
{
    cmd_run ifconfig ens1 up
    cmd_run modprobe 8021q
    cmd_run vconfig add ens1 100
    cmd_run vconfig set_flag ens1.100 1 1 
    cmd_run ifconfig ens1.100 192.168.100.1 netmask 255.255.255.0 up
    cmd_run sleep 1
    log_console_msg "MCN0 : Using static IP config: ens1.100 192.168.100.1"
}

