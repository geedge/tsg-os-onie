config_ethmgmt_static() {
    local intf=$1
    shift

    # eth0 -- BASE#1
    # eth1 -- BASE#2
    # eth2 -- Front GE#1
    # eth3 -- Front GE#2

    # For BASE#1 BASE#2, we use static IP caculated from IPMI address.
    # For Front GE#1, GE#2, use DHCPv4

    local ipmi_output=$(ipmitool picmg addrinfo)
    local sub_str=${ipmi_output:22:1}
    local hex_str=0x$sub_str
    local ip_num=$(printf %d $hex_str)
    local chassis_mgmt_id=$(($ip_num+16))
    local chassis_mgmt_ip_addr="10.254.${chassis_mgmt_id}.1"
    local chassis_mgmt_ip_prefix="255.255.0.0"

    case $intf in
    eth0)
        cmd_run ip -f inet addr flush dev $intf
        cmd_run ip addr add ${chassis_mgmt_ip_addr}/$chassis_mgmt_ip_prefix dev $intf
        log_console_msg "${intf}: Using static IP config: ${chassis_mgmt_ip_addr}/$chassis_mgmt_ip_prefix, intf=$intf"
        ;;
    *)
        return 0
        ;;
    esac

    # other interface, do nothing and disable DHCPv4
    return 0
}